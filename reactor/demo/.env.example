# Copy to .env. Nothing here is needed for a "local" endpoint.
# Endpoints themselves are listed in endpoints.json (and your own endpoints.local.json).

# Optional API key for a hosted endpoint added to endpoints.local.json.
# Read on the server by app/api/token; never sent to the browser. A hosted entry
# you add names its own variable, set it here the same way.
# REACTOR_API_KEY=your-reactor-api-key
